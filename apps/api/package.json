{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d && wrangler dev --port 8000",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "seed": "tsx src/db/seed.ts",
    "lint": "eslint . --max-warnings=0 ",
    "check-types": "tsc --noEmit",
    "migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate",
    "studio": "drizzle-kit studio",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check": "pnpm check-types && pnpm lint && pnpm format"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.9.0",
    "pg": "^8.16.3",
    "ulid": "^3.0.1",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251128.0",
    "@package/eslint-config": "workspace:*",
    "@package/prettier-config": "workspace:*",
    "@package/typescript-config": "workspace:*",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.33.0",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.39.0",
    "wrangler": "^4.28.1"
  }
}
