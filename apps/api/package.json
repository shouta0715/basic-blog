    "pg": "^8.16.3",
    "ulid": "^3.0.1",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@package/eslint-config": "workspace:*",
    "@package/prettier-config": "workspace:*",
    "@package/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.7",
